// OptSens CMP - Google Tag Manager Consent Mode Template
// https://optsens.com

const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const gtagSet = require('gtagSet');
const getCookieValues = require('getCookieValues');
const setInWindow = require('setInWindow');
const callInWindow = require('callInWindow');
const injectScript = require('injectScript');
const queryPermission = require('queryPermission');
const log = require('logToConsole');
const makeInteger = require('makeInteger');
const JSON = require('JSON');
const decodeUriComponent = require('decodeUriComponent');

// ── Step 1: Set default consent state ────────────────────────────────────────

const defaultSettings = {
  'ad_storage': data.defaultAdStorage || 'denied',
  'ad_user_data': data.defaultAdUserData || 'denied',
  'ad_personalization': data.defaultAdPersonalization || 'denied',
  'analytics_storage': data.defaultAnalyticsStorage || 'denied',
  'functionality_storage': data.defaultFunctionalityStorage || 'denied',
  'personalization_storage': data.defaultPersonalizationStorage || 'denied',
  'security_storage': data.defaultSecurityStorage || 'granted',
  'wait_for_update': makeInteger(data.waitForUpdate) || 2000
};

setDefaultConsentState(defaultSettings);

// ── Step 2: Region-specific defaults ─────────────────────────────────────────

if (data.regionSettings) {
  data.regionSettings.forEach(function(row) {
    if (row.region) {
      const regionOverride = {
        'ad_storage': row.adStorage || 'denied',
        'ad_user_data': row.adUserData || 'denied',
        'ad_personalization': row.adPersonalization || 'denied',
        'analytics_storage': row.analyticsStorage || 'denied',
        'functionality_storage': row.functionalityStorage || 'denied',
        'personalization_storage': row.personalizationStorage || 'denied',
        'security_storage': 'granted',
        'region': [row.region]
      };
      setDefaultConsentState(regionOverride);
    }
  });
}

// ── Step 3: Set developer ID + optional features ─────────────────────────────

// Developer ID - will be activated after Google CMP Partner registration
// gtagSet('developer_id.dOPTSENS', true);

if (data.urlPassthrough) {
  gtagSet('url_passthrough', true);
}

if (data.adsDataRedaction) {
  gtagSet('ads_data_redaction', true);
}

// ── Step 4: Read existing consent from OptSens cookie ────────────────────────

const COOKIE_NAME = 'os_consent';

function parseConsentCookie() {
  var cookies = getCookieValues(COOKIE_NAME);
  if (!cookies || !cookies.length || !cookies[0]) return null;

  var decoded = decodeUriComponent(cookies[0]);
  if (!decoded || decoded.indexOf('{') !== 0) return null;

  return JSON.parse(decoded);
}

// The os_consent cookie stores short keys (ad/an/f) with no timestamp; the runtime
// callback (Step 5) passes the full consent object with long keys
// (advertising/analytics/functional). Read whichever is present.
function consentValue(consent, longKey, shortKey) {
  var v = consent[longKey];
  if (typeof v === 'boolean') return v;
  return !!consent[shortKey];
}

function mapConsentToGcm(consent) {
  var advertising = consentValue(consent, 'advertising', 'ad');
  var analytics = consentValue(consent, 'analytics', 'an');
  var functional = consentValue(consent, 'functional', 'f');
  return {
    'ad_storage': advertising ? 'granted' : 'denied',
    'ad_user_data': advertising ? 'granted' : 'denied',
    'ad_personalization': advertising ? 'granted' : 'denied',
    'analytics_storage': analytics ? 'granted' : 'denied',
    'functionality_storage': functional ? 'granted' : 'denied',
    // Functional / Preferences drives both functionality and personalization storage
    'personalization_storage': functional ? 'granted' : 'denied',
    'security_storage': 'granted'
  };
}

// Check if consent already exists (return visitor). The cookie has no timestamp
// field, so apply whenever a parsed consent object is present.
var existingConsent = parseConsentCookie();
if (existingConsent) {
  updateConsentState(mapConsentToGcm(existingConsent));
  log('[OptSens GTM] Applied existing consent from cookie');
}

// ── Step 5: Listen for consent updates from OptSens CDN script ───────────────

// Initialize callback array BEFORE CDN script loads
setInWindow('__optsens_gtm_callbacks', [], false);

function onConsentUpdate(consent) {
  if (!consent) return;
  updateConsentState(mapConsentToGcm(consent));
  log('[OptSens GTM] Consent updated:', consent.action);
}

// Register callback - CDN script will call each function in this array
callInWindow('__optsens_gtm_callbacks.push', onConsentUpdate);

// ── Step 6: Inject OptSens CDN script ────────────────────────────────────────

var apiKey = data.apiKey;
if (!apiKey) {
  data.gtmOnFailure();
  return;
}

var cdnUrl = data.cdnUrl || 'https://cdn.optsens.com';
var scriptUrl = cdnUrl + '/optsens.min.js/' + apiKey;

if (queryPermission('inject_script', scriptUrl)) {
  injectScript(scriptUrl, data.gtmOnSuccess, data.gtmOnFailure, 'optsens-cmp');
} else {
  log('[OptSens GTM] Script injection not permitted for:', scriptUrl);
  data.gtmOnFailure();
}


